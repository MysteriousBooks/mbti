{
  "id": "classic",
  "name": "经典 MBTI",
  "description": "经典 16 型人格测试，4 个维度，64 道题（题库 128 题，每次随机抽取）",
  "dimensions": [
    {
      "id": "ei",
      "name": "外向 / 内向",
      "poles": [
        "E",
        "I"
      ],
      "descriptions": {
        "E": "你从与外部世界的互动中获取能量，喜欢与人交流、参与活动和表达想法，在群体中往往更自在、更有活力。",
        "I": "你从内心世界和独处中获得能量，喜欢安静思考、深度交流和独立空间，在喧嚣之后需要时间恢复精力。"
      }
    },
    {
      "id": "sn",
      "name": "实感 / 直觉",
      "poles": [
        "S",
        "N"
      ],
      "descriptions": {
        "S": "你关注具体事实、现实细节和可验证的经验，相信眼见为实，喜欢用已有技能和实际步骤解决问题。",
        "N": "你关注整体模式、潜在可能和抽象联想，善于构想未来场景，喜欢探索新意和事物背后的意义。"
      }
    },
    {
      "id": "tf",
      "name": "思考 / 情感",
      "poles": [
        "T",
        "F"
      ],
      "descriptions": {
        "T": "你做决定时优先考虑逻辑、客观标准和因果一致性，倾向于用事实分析来减少情绪干扰。",
        "F": "你做决定时优先考虑价值观、人际和谐和他人感受，倾向于在具体情境中权衡对人的影响。"
      }
    },
    {
      "id": "jp",
      "name": "判断 / 感知",
      "poles": [
        "J",
        "P"
      ],
      "descriptions": {
        "J": "你喜欢有计划、有结构和可预期的生活方式，倾向于提前决策、制定清单并按时完成任务。",
        "P": "你喜欢保持开放、灵活和即兴的生活方式，倾向于根据当下情况调整，保留选择直到最后一刻。"
      }
    }
  ],
  "questions": [
